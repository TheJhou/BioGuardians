# PostgreSQL / PostGIS
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_HOST=localhost
DB_PORT=5432

# Conexão usada pela API Node.js (backend)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Backend API
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
CACHE_TTL_MS=30000
CACHE_MAX=100

# Frontend (React + Vite)
VITE_API_URL=https://api.your-domain.com/api
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# GBIF (consulta em tempo real, sem chave)
GBIF_API_BASE=https://api.gbif.org/v1

# OpenTelemetry (opcional — só ativa se OTEL_EXPORTER_OTLP_ENDPOINT estiver definida)
# Em Docker, o overlay docker-compose.observability.yml injeta essas vars automaticamente.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=bioguardians-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# OpenRouter (AI species classification — Claude Sonnet 4)
# Get your API key at https://openrouter.ai/keys
# Used by the ML service to classify species, generate descriptions and assess extinction risk
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ML Service (CBERS-4A WPM satellite detection)
# Register at https://www.dgi.inpe.br/catalogo/explore
INPE_EMAIL=your_email@example.com
ML_SERVICE_URL=http://localhost:8001

# ML Service performance tuning (VM: 8 cores, 64GB RAM)
YOLO_DEVICE=cpu
YOLO_WORKERS=4
DB_POOL_MAX=10
BATCH_CONCURRENCY=4
HTTP_TIMEOUT=120
