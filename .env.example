# PostgreSQL / PostGIS
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_HOST=localhost
DB_PORT=5432

# Conexão usada pela API Node.js (backend)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Backend API
CORS_ORIGIN=http://localhost:5173
CACHE_TTL_MS=30000
CACHE_MAX=100

# Frontend (React + Vite)
VITE_API_URL=http://localhost:3001/api
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# GBIF (consulta em tempo real, sem chave)
GBIF_API_BASE=https://api.gbif.org/v1

# OpenTelemetry (opcional — só ativa se OTEL_EXPORTER_OTLP_ENDPOINT estiver definida)
# Em Docker, o overlay docker-compose.observability.yml injeta essas vars automaticamente.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=bioguardians-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# Pool PostgreSQL (default 20 — ajuste conforme observado no Grafana)
# DB_POOL_MAX=20
