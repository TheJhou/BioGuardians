# PostgreSQL / PostGIS
POSTGRES_USER=bioguard
POSTGRES_PASSWORD=bioguard
POSTGRES_DB=bioguardians
POSTGRES_PORT=5432

# Conexão usada pela API Node.js
DATABASE_URL=postgresql://bioguard:bioguard@localhost:5432/bioguardians

# Google Maps (frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GBIF (consulta em tempo real, sem chave)
GBIF_API_BASE=https://api.gbif.org/v1
