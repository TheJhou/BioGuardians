# PostgreSQL / PostGIS
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# API
PORT=3001
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Cache (LRU in-memory)
CACHE_TTL_MS=30000
CACHE_MAX=100

# GBIF (real-time occurrence lookup, no key needed)
GBIF_API_BASE=https://api.gbif.org/v1

# ML Service (Python VLM for camera trap classification — runs locally with GPU)
# Only needed when running ML service locally; not deployed to production VM.
ML_SERVICE_URL=http://localhost:8001
